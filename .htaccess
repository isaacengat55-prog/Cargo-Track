RewriteEngine On

RewriteRule ^(?:.*/)?assets/style\.css$ style.css [L]
RewriteRule ^cargo_create\.php$ cargoCreate.php [L]
RewriteRule ^cargo_edit\.php$ cargoEdit.php [L]
RewriteRule ^cargo_save\.php$ cargoSave.php [L]
RewriteRule ^cargo_update_info\.php$ cargoUpdateInfo.php [L]
RewriteRule ^cargo_update_status\.php$ cargoUpdateStatus.php [L]
RewriteRule ^cargo_view\.php$ cargoView.php [L]
RewriteRule ^users\.php$ userManagement.php [L]
RewriteRule ^create_admin\.php$ createAdmin.php [L]
RewriteRule ^cargo/(?:index|list_cargo)\.php$ cargo.php [L]
RewriteRule ^cargo/(?:create|create_cargo)\.php$ cargoCreate.php [L]
RewriteRule ^cargo/edit\.php$ cargoEdit.php [L]
RewriteRule ^cargo/view\.php$ cargoView.php [L]
RewriteRule ^cargo/save\.php$ cargoSave.php [L]
RewriteRule ^cargo/update_info\.php$ cargoUpdateInfo.php [L]
RewriteRule ^cargo/update_status\.php$ cargoUpdateStatus.php [L]
RewriteRule ^cargo/dashboard\.php$ dashboard.php [L]
RewriteRule ^users/index\.php$ userManagement.php [L]
